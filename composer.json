{
    "name": "eamann/battlesnake-next",
    "description": "Third-generation Battlesnake competitor: PHP 8.3 + dual-LLM OpenRouter racing brain with flood-fill safety net and MCTS fallback.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BattlesnakeAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BattlesnakeAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox tests/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
