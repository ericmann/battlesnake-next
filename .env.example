# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Dual-model racing: primary fires immediately, secondary after STAGGER_MS.
# Whichever returns a legal move first wins; the other handle is closed.
# Battlesnake's per-move budget is 500ms. After Cloudflare + MCTS overhead we
# realistically have ~430ms for the LLM round-trip. Flash Lite models are the
# only ones that consistently fit that window. Heavier models are fine here
# only if you accept frequent fallback to MCTS.
PRIMARY_MODEL=google/gemini-2.5-flash-lite
SECONDARY_MODEL=google/gemini-2.0-flash-lite-001
LLM_TIMEOUT_MS=450
STAGGER_MS=50

# Optional attribution headers OpenRouter surfaces on its leaderboards.
OPENROUTER_APP_NAME=battlesnake-next
OPENROUTER_REFERER=https://snake.eamann.com

# Snake metadata — surfaced via GET / to the Battlesnake game engine.
SNAKE_AUTHOR=eamann
SNAKE_COLOR=#1a1a2e
SNAKE_HEAD=tongue
SNAKE_TAIL=bolt
