# =====================================================================
# LLM PATH IS CURRENTLY DISABLED.
#
# Google Vertex EU sits at ~500 ms p50 from our deploy region — already
# at the Battlesnake budget — so calling OpenRouter can only hurt us.
# The OpenRouter / curl_multi code is still in the tree (see src/OpenRouter
# .php and src/CurlMultiLlmDriver.php); Controller::move() just doesn't
# wire it in today. The variables below are kept so the LLM path can be
# revived without re-deriving them.
# =====================================================================
OPENROUTER_API_KEY=sk-or-...
PRIMARY_MODEL=google/gemini-2.5-flash-lite
SECONDARY_MODEL=google/gemini-2.5-flash-lite
STAGGER_MS=50
OPENROUTER_APP_NAME=battlesnake-next
OPENROUTER_REFERER=https://snake.eamann.com

# Hard wall-clock cap on the MCTS decision loop. With the LLM disabled,
# every millisecond inside this window is spent on rollouts (no usleep,
# no curl polling). 150 ms gives ~thousands of rollouts on commodity
# hardware while leaving 350 ms of headroom for safety, logging, JSON
# encode, and the Cloudflare tunnel hop. Total /move response stays
# under 350 ms server-side.
DECISION_MS=150

# Snake metadata — surfaced via GET / to the Battlesnake game engine.
SNAKE_AUTHOR=eamann
SNAKE_COLOR=#1a1a2e
SNAKE_HEAD=tongue
SNAKE_TAIL=bolt
