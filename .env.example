# =====================================================================
# LLM brain — Llama on Groq via OpenRouter.
#
# Google Vertex models (the original target) sat at ~500 ms p50 from
# our deploy region, which already exceeded the Battlesnake budget.
# Llama 3.x models served by Groq come in at ~225-420 ms p95 with a
# full board prompt, comfortably inside the budget.
#
# OPENROUTER_PROVIDER pins the request to a single provider with
# allow_fallbacks=false — without strict pinning, OpenRouter falls
# back to slower providers (DeepInfra, AkashML) for tail requests
# and the median latency doubles. Set blank to disable pinning.
# =====================================================================
OPENROUTER_API_KEY=sk-or-...
PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct
SECONDARY_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_PROVIDER=Groq
STAGGER_MS=50
OPENROUTER_APP_NAME=battlesnake-next
OPENROUTER_REFERER=https://snake.eamann.com

# Hard wall-clock cap on the /move decision loop. The loop polls the
# LLM via curl_multi and runs MCTS rollouts in parallel during the
# wait, then picks the best available result (LLM > MCTS > flood-fill).
# 450 ms leaves 50 ms of Battlesnake budget for HTTP overhead through
# the Cloudflare tunnel. Tune via LATENCY_CHECK.php at the venue.
DECISION_MS=450

# Snake metadata — surfaced via GET / to the Battlesnake game engine.
SNAKE_AUTHOR=eamann
SNAKE_COLOR=#1a1a2e
SNAKE_HEAD=tongue
SNAKE_TAIL=bolt
